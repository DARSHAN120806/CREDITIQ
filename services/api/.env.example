# Copy to .env for local use. No PostgreSQL server or role is created by the app.
CREDITIQ_APP_ENV=development
CREDITIQ_MODE=RESEARCH_ONLY
CREDITIQ_RELEASE_READY=false
CREDITIQ_DB_HOSTING=supabase
CREDITIQ_PG_HOST=<supabase-session-pooler-host>
CREDITIQ_PG_PORT=5432
CREDITIQ_PG_DATABASE=<database-name>
CREDITIQ_PG_USER=<restricted-runtime-role-pooler-username>
CREDITIQ_PG_PASSWORD=<runtime-password>
CREDITIQ_PG_SSLMODE=verify-full
CREDITIQ_PG_CONNECTION_MODE=session
CREDITIQ_PG_SSLROOTCERT=<certificate-file-path>
CREDITIQ_DB_POOL_SIZE=5
CREDITIQ_DB_MAX_OVERFLOW=5

# Required: generate locally with Python secrets.token_urlsafe(48); never commit the value.
CREDITIQ_JWT_SECRET=
CREDITIQ_JWT_ISSUER=creditiq-api
CREDITIQ_JWT_AUDIENCE=creditiq-web
CREDITIQ_ACCESS_TOKEN_MINUTES=15
CREDITIQ_REFRESH_TOKEN_DAYS=30
# false is for loopback HTTP development only; staging/production requires true and HTTPS.
CREDITIQ_COOKIE_SECURE=false
CREDITIQ_AUTH_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000","http://127.0.0.1:3000","http://localhost:3000"]
CREDITIQ_AUTH_IP_LIMIT=120
CREDITIQ_AUTH_ACCOUNT_LIMIT=10
CREDITIQ_AUTH_WINDOW_SECONDS=900

# Disable only for isolated foundation/auth tests; enabled for the research prototype.
CREDITIQ_LITE_ENABLED=true
# Hosting migration template and runbook: supabase.env.example and SUPABASE_MIGRATION_PLAN.md.
# Local databases require explicit configuration and are prohibited in staging/production.
# Optional CA certificate path for verify-full:
# CREDITIQ_PG_SSLROOTCERT=<absolute-certificate-path>
# Optional local override; mandatory for Supabase Alembic commands, operator process only:
# CREDITIQ_MIGRATION_DATABASE_URL=<direct-or-session-SQLAlchemy-URL>

# Bounded connection/statement waits; no automatic transactional write retries.
CREDITIQ_DB_CONNECT_TIMEOUT=5
CREDITIQ_DB_POOL_TIMEOUT=30
CREDITIQ_DB_POOL_RECYCLE=300
CREDITIQ_DB_STATEMENT_TIMEOUT_MS=15000
CREDITIQ_DB_LOCK_TIMEOUT_MS=5000
