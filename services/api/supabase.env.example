# TEMPLATE ONLY: replace placeholders in a private environment/secret store. Never commit filled values.
CREDITIQ_DB_HOSTING=supabase
CREDITIQ_PG_HOST=<pooler-host-from-project-connect-panel>
CREDITIQ_PG_PORT=<pooler-port-from-project-connect-panel>
CREDITIQ_PG_DATABASE=<database-name>
CREDITIQ_PG_USER=<restricted-runtime-role-pooler-username>
CREDITIQ_PG_PASSWORD=<runtime-role-password>
CREDITIQ_PG_CONNECTION_MODE=session
CREDITIQ_PG_SSLMODE=verify-full
CREDITIQ_PG_SSLROOTCERT=<absolute-path-to-provider-CA-certificate>
CREDITIQ_DB_POOL_SIZE=5
CREDITIQ_DB_MAX_OVERFLOW=0
CREDITIQ_MODE=RESEARCH_ONLY
CREDITIQ_RELEASE_READY=false

# Operator only, never add this to the API environment:
# CREDITIQ_MIGRATION_DATABASE_URL=<direct-or-session-SQLAlchemy-URL-with-TLS>

# Bounded connection/statement waits; no automatic transactional write retries.
CREDITIQ_DB_CONNECT_TIMEOUT=5
CREDITIQ_DB_POOL_TIMEOUT=30
CREDITIQ_DB_POOL_RECYCLE=300
CREDITIQ_DB_STATEMENT_TIMEOUT_MS=15000
CREDITIQ_DB_LOCK_TIMEOUT_MS=5000

# Deployment-only application security. Fill secrets and HTTPS origins before startup.
CREDITIQ_APP_ENV=production
CREDITIQ_COOKIE_SECURE=true
CREDITIQ_AUTH_ORIGINS=[]
CREDITIQ_JWT_SECRET=
CREDITIQ_LITE_ENABLED=true

