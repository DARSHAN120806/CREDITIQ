[Unit]
Description=CreditIQ external health and alert check
[Service]
Type=oneshot
User=creditiq
EnvironmentFile=/etc/creditiq/monitor.env
ExecStart=/usr/bin/python3 /opt/creditiq/current/deploy/monitor.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
TimeoutStartSec=45
