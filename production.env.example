# PLACEHOLDERS ONLY. Copy to a private env file or hosting secret manager.
CREDITIQ_APP_ENV=production
CREDITIQ_MODE=RESEARCH_ONLY
CREDITIQ_RELEASE_READY=false
CREDITIQ_DB_HOSTING=supabase
CREDITIQ_PG_HOST=<session-pooler-host>
CREDITIQ_PG_PORT=5432
CREDITIQ_PG_DATABASE=postgres
CREDITIQ_PG_USER=creditiq_runtime.<project-ref>
CREDITIQ_PG_PASSWORD=<runtime-password>
CREDITIQ_PG_CONNECTION_MODE=session
CREDITIQ_PG_SSLMODE=verify-full
CREDITIQ_PG_SSLROOTCERT=/run/secrets/supabase-ca.crt
CREDITIQ_DB_POOL_SIZE=5
CREDITIQ_DB_MAX_OVERFLOW=0
CREDITIQ_DB_CONNECT_TIMEOUT=5
CREDITIQ_DB_POOL_TIMEOUT=30
CREDITIQ_DB_POOL_RECYCLE=300
CREDITIQ_DB_STATEMENT_TIMEOUT_MS=15000
CREDITIQ_DB_LOCK_TIMEOUT_MS=5000
CREDITIQ_COOKIE_SECURE=true
CREDITIQ_JWT_SECRET=<generate-with-python-secrets-token_urlsafe-48>
CREDITIQ_API_ORIGIN=https://<api-domain>
CREDITIQ_FRONTEND_ORIGIN=https://<frontend-domain>
CREDITIQ_AUTH_ORIGINS=["https://<frontend-domain>"]
# Non-Render hosts: set exact proxy IPs/CIDRs. On Render web services, remove this line.
CREDITIQ_TRUSTED_PROXY_IPS=<trusted-proxy-ip-or-cidr>
CREDITIQ_LITE_ENABLED=true
PORT=8000
# Frontend BUILD setting, not a secret. Must equal CREDITIQ_API_ORIGIN.
API_ORIGIN=https://<api-domain>
# Never add CREDITIQ_MIGRATION_DATABASE_URL to the runtime service.
